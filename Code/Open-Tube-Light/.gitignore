# ── CMake build output ────────────────────────────────────────────────
build/

# ── Tool metadata ─────────────────────────────────────────────────────
# .settings/ holds the STM32Cube VS Code extension's toolchain bundle info;
# .mxproject is rewritten by CubeMX on every generate (.ioc is the source of truth).
# .project/.cproject are STM32CubeIDE files, kept ignored in case CubeIDE is reopened.
.settings/
.mxproject
.project
.cproject

# ── Docs kept local: copyrighted specs/manuals ────────────────────────
# Third-party specs and datasheets (copyrighted — never commit)
docs/reference/

# ── Per-machine tooling ───────────────────────────────────────────────
.claude/settings.local.json

# ── Python bytecode (tools/) ───────────────────────────────────────────
__pycache__/
